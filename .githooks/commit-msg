#!/bin/bash

IFS= read -r subject < "$1" || [[ -n "$subject" ]] || exit 1
pattern='^\[([[:alnum:]_.-]+)\] [A-Z].*$'

if [[ ! "$subject" =~ $pattern ]]; then
    echo "[commit-msg-hook] The subject must match: [folder] A commit message (or [root] for root files)." >&2
    exit 1
fi

scope=${BASH_REMATCH[1]}
root=$(git rev-parse --show-toplevel) || exit 1
if [[ "$scope" != root ]] && { [[ "$scope" == . || "$scope" == .. ]] || [[ ! -d "$root/$scope" ]]; }; then
    echo "[commit-msg-hook] The scope must name a top-level repository folder, or root." >&2
    exit 1
fi
